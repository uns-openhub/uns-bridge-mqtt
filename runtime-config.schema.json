{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "connections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "boolean"
          },
          "config": {
            "type": "object",
            "properties": {
              "brokerUrl": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "servers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "host": {
                      "type": "string",
                      "minLength": 1
                    },
                    "port": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "mqtt",
                        "mqtts",
                        "ws",
                        "wss",
                        "tcp",
                        "ssl"
                      ]
                    }
                  },
                  "required": [
                    "host"
                  ]
                }
              },
              "port": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "mqtt",
                  "mqtts",
                  "ws",
                  "wss",
                  "tcp",
                  "ssl"
                ]
              },
              "username": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "env"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^UNS_RUNTIME_SECRET_[A-Z][A-Z0-9_]{0,95}$"
                      }
                    },
                    "required": [
                      "provider",
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "password": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "env"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^UNS_RUNTIME_SECRET_[A-Z][A-Z0-9_]{0,95}$"
                      }
                    },
                    "required": [
                      "provider",
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "clean": {
                "type": "boolean"
              },
              "keepalive": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "connectTimeout": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "reconnectPeriod": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reconnectOnConnackError": {
                "type": "boolean"
              },
              "resubscribe": {
                "type": "boolean"
              },
              "queueQoSZero": {
                "type": "boolean"
              },
              "rejectUnauthorized": {
                "type": "boolean"
              },
              "properties": {
                "type": "object",
                "properties": {
                  "sessionExpiryInterval": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "receiveMaximum": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maximumPacketSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "topicAliasMaximum": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "requestResponseInformation": {
                    "type": "boolean"
                  },
                  "requestProblemInformation": {
                    "type": "boolean"
                  },
                  "userProperties": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "ca": {
                "type": "string",
                "minLength": 1
              },
              "cert": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "servername": {
                "type": "string",
                "minLength": 1
              },
              "subscribeTimeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "mappings": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "topicFilter": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qos": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 0
                        },
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        }
                      ]
                    },
                    "topic": {
                      "type": "string",
                      "minLength": 1
                    },
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assetDescription": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectTypeDescription": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dataGroup": {
                      "type": "string",
                      "minLength": 1
                    },
                    "validityMode": {
                      "type": "string",
                      "enum": [
                        "interval",
                        "lifecycle"
                      ]
                    },
                    "lifecycleEndValue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "publishInitialValue": {
                      "type": "boolean"
                    },
                    "expectedIntervalMs": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "outputs": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "topic": {
                            "type": "string",
                            "minLength": 1
                          },
                          "asset": {
                            "type": "string",
                            "minLength": 1
                          },
                          "assetDescription": {
                            "type": "string",
                            "minLength": 1
                          },
                          "objectType": {
                            "type": "string",
                            "minLength": 1
                          },
                          "objectTypeDescription": {
                            "type": "string",
                            "minLength": 1
                          },
                          "objectId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "attribute": {
                            "type": "string",
                            "minLength": 1
                          },
                          "attributeDescription": {
                            "type": "string",
                            "minLength": 1
                          },
                          "selector": {
                            "type": "object",
                            "properties": {
                              "matchField": {
                                "type": "string",
                                "minLength": 1
                              },
                              "matchValue": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "matchField",
                              "matchValue"
                            ]
                          },
                          "extraction": {
                            "type": "object",
                            "properties": {
                              "mode": {
                                "default": "text",
                                "type": "string",
                                "enum": [
                                  "raw",
                                  "text",
                                  "json-path"
                                ]
                              },
                              "path": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        },
                        "required": [
                          "attribute"
                        ]
                      }
                    }
                  },
                  "required": [
                    "topicFilter",
                    "topic",
                    "asset",
                    "objectType",
                    "objectId",
                    "outputs"
                  ]
                }
              },
              "required": [
                "id",
                "config"
              ]
            }
          }
        },
        "required": [
          "id",
          "config"
        ]
      }
    }
  }
}

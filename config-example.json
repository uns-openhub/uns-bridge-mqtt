{
  "uns": {
    "graphql": "http://localhost:3200/graphql",
    "rest": "http://localhost:3200/api",
    "email": "user@example.com",
    "password": {
      "provider": "env",
      "key": "UNS_PASSWORD"
    },
    "processName": "uns-bridge-mqtt",
    "instanceMode": "handover",
    "handover": true,
    "jwksWellKnownUrl": "http://localhost:3200/api/.well-known/jwks.json",
    "kidWellKnownUrl": "http://localhost:3200/api/.well-known/kid",
    "supervisor": {
      "enabled": false
    }
  },
  "infra": {
    "host": "localhost"
  },
  "output": {
    "host": "localhost"
  },
  "bridge": {
    "autoStartConnections": false,
    "api": {
      "instanceName": "bridge-management"
    },
    "publisher": {
      "instanceName": "bridge-publisher",
      "publishThrottlingDelay": 0
    },
    "retry": {
      "minDelayMs": 500,
      "maxDelayMs": 15000,
      "maxAttempts": 1000
    }
  }
}
